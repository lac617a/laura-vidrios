# Copia este archivo como .env para desarrollo local.
# En producción (Vercel + Neon) estas variables viven solo en el panel de Vercel.
# NUNCA pongas aquí la URL de la base de datos de producción.

# ── Base de datos ─────────────────────────────────────────────
# Runtime de la app. Local: Postgres en tu PC. Producción: Neon con pooler (-pooler).
DATABASE_URL="postgresql://postgres@localhost:5432/lauravidrio"
# Conexión directa, solo para migraciones. En local se deja vacía y se usa DATABASE_URL.
# La integración Vercel ↔ Neon la crea sola en producción y en previews.
# DATABASE_URL_UNPOOLED=""

# ── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cuando haya dominio propio, proxy.ts redirige (308) cualquier otro host a este.
# CANONICAL_HOST=""

# ── Auth ──────────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En Vercel usa un valor distinto para producción y para previews.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Cloudinary (Sprint 3) ─────────────────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Seed (solo local) ─────────────────────────────────────────
# Número de WhatsApp de prueba para el seed (57 + 10 dígitos). Usa el tuyo para probar.
# SEED_WHATSAPP_NUMBER=""
# El seed crea dos usuarios SOLO en la BD local:
#   admin@local.test  (acceso total)   ·   editor@local.test  (edición)
# Contraseña de ambos: "espejos-local-2026", o la que pongas aquí.
# SEED_ADMIN_PASSWORD=""
